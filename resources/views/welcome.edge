<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex">
  <title>GitGone</title>
  <link rel="icon" href="/assets/logo.svg" type="image/svg+xml">
  <style>
    :root {
      color-scheme: light;
      --background: #fafafa;
      --glow: #e8f3e1;
      --foreground: #18181b;
      --card: #ffffff;
      --muted: #f4f4f5;
      --muted-foreground: #71717a;
      --border: #e4e4e7;
      --brand: #60a441;
      --ok: #60a441;
      --warning: #d99a06;
      --danger: #dc2626;
    }

    @media (prefers-color-scheme: dark) {
      :root {
        color-scheme: dark;
        --background: #141416;
        --glow: #1b2617;
        --foreground: #ededef;
        --card: #1b1b1f;
        --muted: #232328;
        --muted-foreground: #a0a0a8;
        --border: #2c2c32;
        --brand: #6bb34b;
        --ok: #6bb34b;
        --warning: #eab308;
        --danger: #f87171;
      }
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 64px 16px 40px;
      background: radial-gradient(1200px 600px at 50% -10%, var(--glow) 0%, var(--background) 55%);
      color: var(--foreground);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }

    .brand { display: flex; align-items: center; gap: 8px; font-weight: 600; margin-bottom: 40px; }
    .brand svg { width: 20px; height: 23px; fill: var(--brand); }

    .hero { text-align: center; margin-bottom: 28px; }
    .orb { --tone: var(--ok); position: relative; width: 88px; height: 88px; margin: 0 auto 18px; }
    .status-setup .orb { --tone: var(--warning); }
    .status-degraded .orb { --tone: var(--danger); }
    .orb span { position: absolute; inset: 0; border-radius: 50%; background: var(--tone); opacity: 0.15; animation: pulse 2.4s ease-out infinite; }
    .orb span:nth-child(2) { animation-delay: 1.2s; }
    .orb i { position: absolute; inset: 26px; border-radius: 50%; background: var(--tone); box-shadow: 0 0 0 6px var(--card); }
    @keyframes pulse { 0% { transform: scale(0.5); opacity: 0.35; } 100% { transform: scale(1.25); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .orb span { animation: none; } }

    h1 { font-size: 28px; line-height: 1.2; letter-spacing: -0.02em; text-wrap: balance; }
    .sub { color: var(--muted-foreground); margin-top: 6px; }

    .card { width: 100%; max-width: 560px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }


    .connect { padding: 18px; display: flex; flex-direction: column; gap: 6px; }
    .connect p { color: var(--muted-foreground); font-size: 13px; margin-bottom: 4px; }
    .code { display: flex; align-items: center; gap: 8px; padding: 0 4px 0 12px; height: 38px; background: var(--muted); border: 1px solid var(--border); border-radius: 6px; }
    .code code { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .copy { flex-shrink: 0; height: 28px; padding: 0 8px; border: none; border-radius: 4px; background: transparent; color: var(--muted-foreground); font: inherit; font-size: 12px; cursor: pointer; }
    .copy:hover { background: var(--card); color: var(--foreground); }
    .copy:focus-visible, .links a:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }

    .links { margin-top: 20px; display: flex; flex-wrap: wrap; justify-content: center; gap: 18px; font-size: 13px; }
    .links a { color: var(--muted-foreground); }
  </style>
</head>
<body class="status-{{ status }}">
  <div class="brand">
    <svg viewBox="0 0 87 100" aria-hidden="true">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M0 33.4863V25L43.3008 0L86.6025 25V33.4854L79.6504 37.5V62.5L86.6025 66.5137V75L43.3008 100L0 75V66.5127L6.95117 62.5V37.5L0 33.4863ZM64.9512 62.5V37.5L43.3008 25L21.6504 37.5V62.5L43.3008 75L64.9512 62.5Z"/>
    </svg>
    GitGone
  </div>

  <div class="hero">
    <div class="orb" aria-hidden="true"><span></span><span></span><i></i></div>
    <h1>
      @if(status === 'ok')
        Tout fonctionne
      @elseif(status === 'setup')
        Instance à configurer
      @else
        Problème détecté
      @endif
    </h1>
    <p class="sub mono">{{ serverUrl.replace(/^https?:\/\//, '') }} · v{{ version }}</p>
  </div>

  <main class="card">
    <div class="connect">
      @if(status === 'setup')
        <p>Créer le compte administrateur depuis la CLI</p>
      @else
        <p>Connecter la CLI</p>
      @endif
      <div class="code"><code class="mono">gitgone config set serverUrl {{ serverUrl }}</code><button class="copy" type="button">Copier</button></div>
      @if(status === 'setup')
        <div class="code"><code class="mono">gitgone admin setup</code><button class="copy" type="button">Copier</button></div>
      @else
        <div class="code"><code class="mono">gitgone login</code><button class="copy" type="button">Copier</button></div>
      @endif
    </div>
  </main>

  <nav class="links">
    <a href="https://docs.gitgone.org" target="_blank" rel="noreferrer">Documentation</a>
    <a href="/healthcheck">/healthcheck</a>
    <a href="https://github.com/project-gitgone" target="_blank" rel="noreferrer">Code source</a>
  </nav>

  <script>
    document.querySelectorAll('.copy').forEach((button) => {
      button.addEventListener('click', async () => {
        const text = button.previousElementSibling.textContent
        try {
          await navigator.clipboard.writeText(text)
          button.textContent = 'Copié'
        } catch {
          button.textContent = 'Échec'
        }
        setTimeout(() => (button.textContent = 'Copier'), 1500)
      })
    })
  </script>
</body>
</html>
